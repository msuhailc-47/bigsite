rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /dorek_cms/submissions {
      // Anyone can create/update submissions (public contact form)
      allow write: if true;
      allow read: if request.auth != null;
    }

    match /dorek_cms/{document} {
      // Anyone can read CMS data
      allow read: if true;
      // Only authenticated users (admins) can write CMS data
      allow write: if request.auth != null;
    }
    
    // Block everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
