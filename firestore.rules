rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /dorek_cms/submissions {
      // Anyone can create/update submissions (public contact form)
      allow write: if true;
      allow read: if request.auth != null;
    }

    match /dorek_cms/analytics {
      // Allow public write/increment for website visitor counter
      allow read, write: if true;
    }

    match /dorek_cms/pulse_page_content {
      // Public read and write for live QR page CMS content sync
      allow read, write: if true;
    }

    match /dorek_cms/notification_settings {
      // Notification configuration sync
      allow read, write: if true;
    }

    match /dorek_cms/{document} {
      // Anyone can read CMS data
      allow read: if true;
      // Only authenticated users (admins) can write CMS data
      allow write: if request.auth != null;
    }
    
    match /dorek_pulse_tickets/{ticketId} {
      // Anyone can create a review or service call ticket from QR scan
      allow create: if true;
      // Allow read, update, and delete for staff portal and admin dashboard
      allow read, update, delete: if true;
    }

    // Block everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
